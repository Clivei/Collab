# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only

# ── AI (KPI suggestions + monthly report) ──────────────────
AI_PROVIDER=anthropic             # anthropic | gemini | off
ANTHROPIC_API_KEY=                # server only
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=                   # server only
GEMINI_MODEL=gemini-2.0-flash

# ── Web Push (generate: npx web-push generate-vapid-keys) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                # server only
VAPID_SUBJECT=mailto:admin@norapadel.my.id

# ── WhatsApp (daily recap) ──────────────────────────────────
WA_PROVIDER=fonnte                # fonnte | waba | off
FONNTE_API_KEY=                   # server only
WABA_TOKEN=                       # server only (official WhatsApp Business API)
WABA_PHONE_NUMBER_ID=
OWNER_WA_NUMBER=                  # E.164 without +, e.g. 62812xxxxxxx

# ── Cron ────────────────────────────────────────────────────
CRON_SECRET=                      # protects /api/cron/* endpoints
DEFAULT_TZ=Asia/Jakarta

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://teamos.norapadel.my.id
